<powershell>
# =============================================================================
# user_data stub — pulls real bootstrap scripts from S3 and runs them.
# Templated by Terraform. PS variables and sub-expressions are escaped with
# double-dollar throughout this file so Terraform leaves them alone.
# =============================================================================

$ErrorActionPreference = 'Stop'
$LogPath = 'C:\bootstrap.log'
Start-Transcript -Path $LogPath -Append -Force | Out-Null

Write-Host "=== userdata stub starting at $(Get-Date -Format o) ==="

# State directory — scripts use this to track progress across reboots
$StateDir = 'C:\bootstrap-state'
New-Item -ItemType Directory -Path $StateDir -Force | Out-Null

# Context passed to all scripts via env vars (stable across reboots once we
# write them to machine-scoped environment as a backup mechanism)
$env:LAB_BUCKET           = '${bucket_name}'
$env:LAB_ROLE             = '${role}'
$env:LAB_DOMAIN_NAME      = '${domain_name}'
$env:LAB_DOMAIN_NETBIOS   = '${domain_netbios}'
$env:LAB_DOMAIN_ADMIN_PW  = '${domain_admin_pw}'
$env:LAB_DSRM_PW          = '${dsrm_pw}'
$env:LAB_ALICE_PW         = '${alice_pw}'
$env:LAB_BOB_PW           = '${bob_pw}'
$env:LAB_SVC_BACKUP_PW    = '${svc_backup_pw}'
$env:LAB_WAZUH_IP         = '${wazuh_manager_ip}'
$env:LAB_DC_IP            = '${dc_private_ip}'

# Persist to machine env so post-reboot scheduled tasks can read them.
# Handle empty / missing values gracefully (some vars are blank on the DC).
foreach ($n in @('LAB_BUCKET','LAB_ROLE','LAB_DOMAIN_NAME','LAB_DOMAIN_NETBIOS','LAB_DOMAIN_ADMIN_PW','LAB_DSRM_PW','LAB_ALICE_PW','LAB_BOB_PW','LAB_SVC_BACKUP_PW','LAB_WAZUH_IP','LAB_DC_IP')) {
    $val = [Environment]::GetEnvironmentVariable($n, 'Process')
    if ($null -eq $val) { $val = '' }
    [Environment]::SetEnvironmentVariable($n, $val, 'Machine')
}

# Wait for AWS Tools / SSM agent to be ready (they ship preinstalled on the AMI)
Import-Module AWSPowerShell.NetCore -ErrorAction SilentlyContinue
if (-not (Get-Module AWSPowerShell.NetCore)) {
    Import-Module AWSPowerShell -ErrorAction SilentlyContinue
}

# Pull all bootstrap scripts from S3
$ScriptDir = 'C:\bootstrap'
New-Item -ItemType Directory -Path $ScriptDir -Force | Out-Null

$scripts = @('10-common.ps1', '20-promote-dc.ps1', '30-domain-join.ps1', '40-install-art.ps1')
foreach ($s in $scripts) {
    $local = Join-Path $ScriptDir $s
    Write-Host "Downloading s3://$env:LAB_BUCKET/bootstrap/$s -> $local"
    Read-S3Object -BucketName $env:LAB_BUCKET -Key "bootstrap/$s" -File $local | Out-Null
}

# Phase 1 — common bootstrap (Sysmon, audit policy, PS logging, Wazuh agent if IP known)
Write-Host "=== running 10-common.ps1 ==="
& (Join-Path $ScriptDir '10-common.ps1')

# Phase 2 — role-specific
if ($env:LAB_ROLE -eq 'dc') {
    Write-Host "=== running 20-promote-dc.ps1 ==="
    & (Join-Path $ScriptDir '20-promote-dc.ps1')
} elseif ($env:LAB_ROLE -eq 'member') {
    Write-Host "=== running 30-domain-join.ps1 ==="
    & (Join-Path $ScriptDir '30-domain-join.ps1')
    # ART install runs after domain join completes (post-reboot, via scheduled task)
}

Write-Host "=== userdata stub finished at $(Get-Date -Format o) ==="
Stop-Transcript
</powershell>
<persist>true</persist>
